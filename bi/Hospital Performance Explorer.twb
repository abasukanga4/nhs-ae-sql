      <column name="[Department]" caption="Department type" datatype="string" role="measure" type="nominal" param-domain-type="list" value="&quot;Type 1&quot;">
        <calculation class="tableau" formula="&quot;Type 1&quot;" />
        <members>
          <member value="&quot;Type 1&quot;" />
          <member value="&quot;All types&quot;" />
        </members>
      </column>
      <column name="[Window]" caption="Reporting window" datatype="string" role="measure" type="nominal" param-domain-type="list" value="&quot;Latest 12 months&quot;">
        <calculation class="tableau" formula="&quot;Latest 12 months&quot;" />
        <members>
          <member value="&quot;Full 24 months&quot;" />
          <member value="&quot;Latest 12 months&quot;" />
        </members>
