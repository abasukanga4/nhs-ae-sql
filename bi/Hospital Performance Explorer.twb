    <datasource name="provider_data" caption="NHS England provider-months" inline="true" version="10.5">
      <connection class="textscan" directory="Data" filename="providers.csv" password="" server="">
        <relation name="providers" table="[providers.csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_GB" separator=",">
            <column name="period_month" datatype="date" ordinal="0" />
            <column name="org_code" datatype="string" ordinal="1" />
            <column name="region" datatype="string" ordinal="2" />
            <column name="org_name" datatype="string" ordinal="3" />
            <column name="att_type1" datatype="integer" ordinal="4" />
            <column name="att_all" datatype="integer" ordinal="5" />
            <column name="over4hr_type1" datatype="integer" ordinal="6" />
            <column name="over4hr_all" datatype="integer" ordinal="7" />
            <column name="waited_4_12hr_dta" datatype="integer" ordinal="8" />
            <column name="waited_12hr_dta" datatype="integer" ordinal="9" />
            <column name="perf_all" datatype="real" ordinal="10" />
            <column name="perf_type1" datatype="real" ordinal="11" />
          </columns>
        </relation>
      </connection>
      <column name="[period_month]" caption="Period Month" datatype="date" role="dimension" type="ordinal" default-format="dmmm yy" />
      <column name="[org_code]" caption="Org Code" datatype="string" role="dimension" type="nominal" />
      <column name="[region]" caption="Region" datatype="string" role="dimension" type="nominal" />
      <column name="[org_name]" caption="Org Name" datatype="string" role="dimension" type="nominal" />
      <column name="[att_type1]" caption="Att Type1" datatype="integer" role="measure" type="quantitative" />
      <column name="[att_all]" caption="Att All" datatype="integer" role="measure" type="quantitative" />
      <column name="[over4hr_type1]" caption="Over4Hr Type1" datatype="integer" role="measure" type="quantitative" />
      <column name="[over4hr_all]" caption="Over4Hr All" datatype="integer" role="measure" type="quantitative" />
      <column name="[waited_4_12hr_dta]" caption="Waited 4 12Hr Dta" datatype="integer" role="measure" type="quantitative" />
      <column name="[waited_12hr_dta]" caption="Waited 12Hr Dta" datatype="integer" role="measure" type="quantitative" />
      <column name="[perf_all]" caption="Perf All" datatype="real" role="measure" type="quantitative" />
      <column name="[perf_type1]" caption="Perf Type1" datatype="real" role="measure" type="quantitative" />
      <column name="[Selected attendances]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Parameters].[Department] = 'Type 1' THEN [att_type1] ELSE [att_all] END" />
      </column>
      <column name="[Selected over four hours]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Parameters].[Department] = 'Type 1' THEN [over4hr_type1] ELSE [over4hr_all] END" />
      </column>
      <column name="[Within four hours]" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([Selected attendances]) &gt; 0 THEN 1 - SUM([Selected over four hours]) / SUM([Selected attendances]) END" />
      </column>
      <column name="[Provider selected]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="([Parameters].[Provider] = 'All providers' OR [org_code] = [Parameters].[Provider]) AND [Selected attendances] &gt; 0 AND ([Parameters].[Window] = 'Full 24 months' OR [period_month] &gt;= #2025-04-01#)" />
      </column>
      <extract count="4758" enabled="true" units="records">
        <connection class="hyper" dbname="Data/Extracts/providers.hyper" schema="Extract" tablename="Extract" access-mode="readonly" authentication="auth-none">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
        </connection>
      </extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Monthly performance">
      <table>
        <view>
          <datasources>
            <datasource name="provider_data" caption="NHS England provider-months" />
          </datasources>
          <datasource-dependencies datasource="provider_data">
            <column name="[period_month]" caption="Period Month" datatype="date" role="dimension" type="ordinal" default-format="dmmm yy" />
            <column name="[org_code]" caption="Org Code" datatype="string" role="dimension" type="nominal" />
            <column name="[region]" caption="Region" datatype="string" role="dimension" type="nominal" />
            <column name="[org_name]" caption="Org Name" datatype="string" role="dimension" type="nominal" />
            <column name="[att_type1]" caption="Att Type1" datatype="integer" role="measure" type="quantitative" />
            <column name="[att_all]" caption="Att All" datatype="integer" role="measure" type="quantitative" />
            <column name="[over4hr_type1]" caption="Over4Hr Type1" datatype="integer" role="measure" type="quantitative" />
            <column name="[over4hr_all]" caption="Over4Hr All" datatype="integer" role="measure" type="quantitative" />
            <column name="[waited_4_12hr_dta]" caption="Waited 4 12Hr Dta" datatype="integer" role="measure" type="quantitative" />
            <column name="[waited_12hr_dta]" caption="Waited 12Hr Dta" datatype="integer" role="measure" type="quantitative" />
            <column name="[perf_all]" caption="Perf All" datatype="real" role="measure" type="quantitative" />
            <column name="[perf_type1]" caption="Perf Type1" datatype="real" role="measure" type="quantitative" />
            <column name="[Selected attendances]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Parameters].[Department] = 'Type 1' THEN [att_type1] ELSE [att_all] END" />
            </column>
            <column name="[Selected over four hours]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Parameters].[Department] = 'Type 1' THEN [over4hr_type1] ELSE [over4hr_all] END" />
            </column>
            <column name="[Within four hours]" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="IF SUM([Selected attendances]) &gt; 0 THEN 1 - SUM([Selected over four hours]) / SUM([Selected attendances]) END" />
            </column>
            <column name="[Provider selected]" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Provider] = 'All providers' OR [org_code] = [Parameters].[Provider]) AND [Selected attendances] &gt; 0 AND ([Parameters].[Window] = 'Full 24 months' OR [period_month] &gt;= #2025-04-01#)" />
            </column>
            <column-instance column="[period_month]" derivation="None" name="[none:period_month:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Within four hours]" derivation="User" name="[usr:Within four hours:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Provider selected]" derivation="None" name="[none:Provider selected:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[provider_data].[none:Provider selected:nk]">
            <groupfilter function="member" level="[none:Provider selected:nk]" member="true" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="mark">
            <format attr="mark-color" value="#147d92" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
          </pane>
        </panes>
        <rows>[provider_data].[usr:Within four hours:qk]</rows>
        <cols>[provider_data].[none:period_month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monthly attendances">
      <table>
        <view>
          <datasources>
            <datasource name="provider_data" caption="NHS England provider-months" />
          </datasources>
          <datasource-dependencies datasource="provider_data">
            <column name="[period_month]" caption="Period Month" datatype="date" role="dimension" type="ordinal" default-format="dmmm yy" />
            <column name="[org_code]" caption="Org Code" datatype="string" role="dimension" type="nominal" />
            <column name="[region]" caption="Region" datatype="string" role="dimension" type="nominal" />
            <column name="[org_name]" caption="Org Name" datatype="string" role="dimension" type="nominal" />
